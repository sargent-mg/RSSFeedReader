@page "/"
@inject RSSFeedReader.UI.Services.SubscriptionClient SubscriptionClient

<PageTitle>Subscriptions</PageTitle>

<h1>Subscriptions</h1>

<form @onsubmit="AddSubscriptionAsync" @onsubmit:preventDefault="true">
    <label for="subscription-url">Feed URL</label>
    <input id="subscription-url" @bind="subscriptionUrl" autocomplete="url" />
    <button type="submit" disabled="@isSubmitting">Add subscription</button>
</form>

@if (isLoading)
{
    <p>Loading subscriptions...</p>
}
else
{
    <h2>Subscription list</h2>
    <ul aria-live="polite">
        @foreach (var subscription in subscriptions)
        {
            <li>@subscription.Url</li>
        }
    </ul>
}

@code {
    private readonly List<RSSFeedReader.UI.Models.Subscription> subscriptions = [];
    private string subscriptionUrl = string.Empty;
    private bool isLoading = true;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        subscriptions.AddRange(await SubscriptionClient.GetAllAsync());
        isLoading = false;
    }

    private async Task AddSubscriptionAsync()
    {
        if (string.IsNullOrWhiteSpace(subscriptionUrl))
        {
            return;
        }

        isSubmitting = true;
        var subscription = await SubscriptionClient.AddAsync(subscriptionUrl);
        if (subscription is not null)
        {
            subscriptions.Add(subscription);
            subscriptionUrl = string.Empty;
        }

        isSubmitting = false;
    }
}
